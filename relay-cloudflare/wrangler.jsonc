{
  "name": "rosorah-kofi",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "KofiAccount" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KofiAccount"] }],
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },{ "name": "REGISTER_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
